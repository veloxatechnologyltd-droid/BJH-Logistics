# API listens locally on this port.
API_PORT=3001

# Browser origin allowed to call the API. CORS_ORIGINS (comma-separated) overrides it.
WEB_ORIGIN=http://127.0.0.1:3002

# API bind address. Defaults to 127.0.0.1; set 0.0.0.0 inside a container.
# API_HOST=127.0.0.1

# Header that carries the visitor's real address, for rate limits. Leave unset
# locally. On Render the blueprint sets it to cf-connecting-ip (written by
# Cloudflare); never set it where callers can reach the API directly.
# CLIENT_IP_HEADER=

# Local-only first super_admin signup; never enable this in a deployed environment.
SUPER_ADMIN_BOOTSTRAP_ENABLED=true

# Super admin must enter an SMS code at sign-in (Supabase phone MFA). Leave off
# until phone MFA and an SMS provider are set up in Supabase.
# SUPER_ADMIN_MFA_REQUIRED=true

# The Next.js starter page links to this local API endpoint.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api

# Supabase URL and publishable key for local Auth sign-in and API JWT verification.
# Use the local values printed by `corepack pnpm exec supabase status`.
# The publishable key is public; never put a service-role key in the web bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local Supabase service role for API-only account administration. Never expose to web.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection URI; server-only and required. Use the local Supabase URL
# for development. Never put this or a secret key in NEXT_PUBLIC_ vars.
DATABASE_URL=

# Download the project's root CA from Supabase Database > SSL Configuration.
# This relative path is resolved from apps/api and points to ignored .local/.
DATABASE_SSL_CA_PATH=../../.local/supabase-root.crt

# --- Customer messages (email and SMS) ---------------------------------------
# Public address of the web app: the link inside every SMS and email points here.
# Defaults to the first WEB_ORIGIN.
# PUBLIC_WEB_URL=https://portal.bjhlogistics.com

# Email goes out by plain SMTP, so any mailbox provider works. Both values below
# are required to send real email; without them emails are only recorded (stub).
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM="BJH Logistics <noreply@bjhlogistics.com>"
# Replies to inquiries go out from the inquiries mailbox (same server as above).
# With SMTP set but no EMAIL_INQUIRY_FROM, an inquiry reply fails rather than
# going out from the quote mailbox.
# EMAIL_INQUIRY_FROM="BJH Logistics <inquiries@bjhlogistics.com>"
# EMAIL_INQUIRY_SMTP_USER=inquiries@bjhlogistics.com
# EMAIL_INQUIRY_SMTP_PASSWORD=
# Replies to customers' emails (the assistant's and staff's) go out from Henry's
# mailbox, in the reply template with his signature, on the same mail server.
# Reply-To is the mailbox the request came in on, so answers come back in.
# Without EMAIL_REPLY_FROM, replies keep the quotes/inquiries senders above.
# EMAIL_REPLY_FROM="Henry Yaw Somuah <henry@bjhlogistics.com>"
# EMAIL_REPLY_SMTP_USER=henry@bjhlogistics.com
# EMAIL_REPLY_SMTP_PASSWORD=
# Problems, feature requests and questions sent with the in-app "Get help"
# button are emailed here (the developer). Without it they are only saved.
# SUPPORT_EMAIL_TO=
# Notifications that reach staff with BJH closed (Web Push). Make the keys once
# with `npx web-push generate-vapid-keys` and set all three on the API service
# only (the web app asks the API for the public key). VAPID_SUBJECT is a contact
# the push services can reach: a mailto: or https: address. Without all three,
# push is off: nothing is offered to browsers and nothing is sent. Keep the
# private key out of git and never change it casually: every browser would have
# to turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:
# Website and portal quote requests are also emailed here so staff see them in
# the mailbox; defaults to INBOUND_IMAP_USER. The reader skips these copies.
# REQUEST_COPY_TO=quotes@bjhlogistics.com

# SMS goes out through Arkesel (sms.arkesel.com API v2). Without the key, SMS is
# only recorded (stub). The sender ID is at most 11 characters and must be
# registered with Arkesel.
# ARKESEL_API_KEY=
# SMS_SENDER_ID=BJHLogistics

# The API sends queued messages on a timer. Set NOTIFICATIONS_WORKER=off to pause it.
# NOTIFICATIONS_WORKER=on
# NOTIFICATIONS_INTERVAL_MS=10000

# --- Customer requests by email -----------------------------------------------
# An email service posts each customer email to POST /api/v1/inbound-email
# (see docs/email-intake.md). It proves itself with this secret, sent as a Bearer
# token, as the password of Basic auth, or in an x-inbound-secret header. Use a long
# random value. Without it, email intake is off.
# INBOUND_EMAIL_SECRET=
# AI reads each email to fill in the request details (service, route, cargo...) for
# a person to check. Without a key the email is still saved and a person fills the
# details in. No model is built in: set both the key and the model, or OpenAI stays
# off. With Claude set up too, OpenAI is the fallback: any Claude call that fails
# (outage, limit, refusal, unreadable answer) is sent to OpenAI instead, files included.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Claude is preferred when its key is set: it reads the emails above AND, from a
# job's "Read details", the job's PDFs and images (scans and photos too) into a
# draft of shipment references for a person to check. Without it, emails use
# OpenAI (if set) and documents fall back to reading a PDF's text layer here.
# Only synthetic/demo documents until BJH agrees in writing (MEMORY.md 2026-10-20).
# It also scores how well each business found by a campaign fits (Sales > Campaigns):
# only public business details (name, type, address, website text, rating) and the
# campaign's own fit rules are sent, never customer data. Without it, simple rules score.
# ANTHROPIC_API_KEY=
# Required with the key (no model is built in); one model for every AI feature,
# Bra Evans included. Example: claude-haiku-5-5.
# CLAUDE_MODEL=
# The email assistant sends its drafted reply to the sender by itself, without
# prices, instead of waiting for a person to press Send. Quotes still need a person
# to issue them. Off unless set (docs/email-intake.md).
# ASSISTANT_AUTO_REPLY=on


# Lead generation: the business search behind Sales > Campaigns. With the token it
# searches Google Maps through BJH's own Apify account; without it a stub returns
# synthetic businesses (marked "stub") and nothing leaves the machine.
# APIFY_API_TOKEN=
# The search tool (default lukaskrivka/google-maps-with-contact-details, which also returns
# emails and social media pages, about $0.01 a business; compass/crawler-google-places
# works too but found no emails in BJH's first search).
# APIFY_ACTOR_ID=
# Most one search may cost, in US dollars (default 5); Apify stops the run at the cap.
# APIFY_MAX_CHARGE_USD=
# The API moves campaign runs along on a timer. Set LEAD_RUNS_WORKER=off to pause it;
# LEAD_RUNS_INTERVAL_MS is how often it looks for work (default 5000).
# LEAD_RUNS_WORKER=on
# LEAD_RUNS_INTERVAL_MS=
